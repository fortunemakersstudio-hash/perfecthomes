# ==============================================================================
# PERFECT HOMES & DEVELOPERS — HOSTINGER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in your website root on Hostinger:
#   cp .env.example .env
# Or add these environment variables in Hostinger hPanel -> Node.js Web App
# ==============================================================================

# 1. APPLICATION SERVER CONFIGURATION
PORT=3000
NODE_ENV=production

# 2. AUTHENTICATION & SECURITY SECRETS
# Generate a strong 64-character random string for AUTH_SECRET
AUTH_SECRET=ph_sec_replace_with_a_secure_random_64_char_key_for_production_2026

# Administrator Initial / Fallback Password (for srilakshman73@gmail.com)
ADMIN_INITIAL_PASSWORD=PerfectAdmin#2026!Secure

# 3. HOSTINGER MYSQL DATABASE CONFIGURATION
# Fill in these values after creating a MySQL Database in Hostinger hPanel:
# (hPanel -> Websites -> Manage -> Databases -> Management -> Create New MySQL Database)
# Note: On Hostinger managed web hosting, DB_HOST is usually 'localhost' or '127.0.0.1'
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_perfecthomes
DB_USER=u123456789_phuser
DB_PASSWORD=ReplaceWithYourHostingerDbPassword

# ==============================================================================
# NOTE ON DATABASE MODES:
# If DB_HOST / DB_USER / DB_NAME are left blank or unset, the application automatically
# runs using the high-performance local persistent JSON storage engine (data/users_database.json).
# Once you provide Hostinger MySQL credentials, it automatically connects, creates all tables,
# and migrates your data seamlessly!
# ==============================================================================
